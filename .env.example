# SocialTransformer Environment Configuration
# Copy this file to .env and update with your machine's absolute paths.
#
# These variables point to directories OUTSIDE the repo (data and experiments).
# All shell scripts source this file automatically.

# Root data directory (contains demonstrations_data_NN/, experiment_data/, model_predictions/)
export DATA_DIR=/path/to/data

# Specific training dataset directory (e.g., DATA_DIR/demonstrations_data_04)
export TRAINING_DATA_DIR=/path/to/data/demonstrations_data_04

# Experiments output directory (runs are created under EXPERIMENTS_DIR/runs/<run_id>/)
export EXPERIMENTS_DIR=/path/to/experiments/dev
