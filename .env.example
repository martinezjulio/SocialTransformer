# SocialTransformer Environment Configuration
# Copy this file to .env and update with your machine's absolute paths.
#
# These variables point to directories OUTSIDE the repo (data and experiments).
export CONDA_SETUP=/path/to/conda.sh # Path to conda.sh setup script (e.g., ~/miniforge3/etc/profile.d/conda.sh)
export TRAINING_DATA_ROOT=/path/to/data # Root data directory - where datasets will be generated and stored
export TRAINING_DATA_DIR=/path/to/data/demonstrations_data_04 # Specific training dataset directory (e.g., TRAINING_DATA_ROOT/demonstrations_data_04)
export MODELING_DATA_DIR=/path/to/experiments/dev # Root modeling outputs directory. Structure:
#   $MODELING_DATA_DIR/
#     training_runs/          # Per-run directories keyed by wandb ID
#       wandb_<id>/
#         checkpoints/        # .pt files (local or downloaded from wandb)
#         wandb/              # wandb logs
#     eval/                   # Evaluation outputs (overwrites on re-run)
#       data/                 # evaluation CSVs
#       figures/              # evaluation plots
#       metadata/             # config.yaml, run.yaml
#     analysis/               # Inference/analysis outputs (overwrites on re-run)
#       data/                 # inference CSVs
#       figures/              # inference/analysis plots
#       metadata/             # config.yaml, run.yaml
export EXPERIMENT_DATA_PATH=/path/to/data # Human experiment CSV used by inference
export WANDB_DIR=$MODELING_DATA_DIR # where wandb logs and checkpoints will be saved
export WANDB_ENTITY=your-wandb-username # your wandb username
export WANDB_PROJECT=your-project-name # your wandb project name
