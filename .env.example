# SocialTransformer Environment Configuration
# Copy this file to .env and update with your machine's absolute paths.
#
# These variables point to directories OUTSIDE the repo (data and experiments).
export CONDA_SETUP=/path/to/conda.sh # Path to conda.sh setup script (e.g., ~/miniforge3/etc/profile.d/conda.sh)
export TRAINING_DATA_ROOT_DIR=/path/to/training_data # Root data directory - where datasets will be generated and stored
export OUTPUT_DATA_DIR=/path/to/outputs # Root output directory.
export EXPERIMENT_DATA_DIR=/path/to/experiment_data # Root directory for human experiment data
export WANDB_ENTITY=your-wandb-username # your wandb username
export WANDB_PROJECT=your-project-name # your wandb project name
# SLURM (scripts/slurm/submit.sh); optional, the defaults are Sherlock's
export SLURM_CPU_PARTITION=normal # table blocks and assembly
export SLURM_GPU_PARTITION=owners # fits, simulated datasets and PPC draws, one GPU each (preemptible: tasks requeue)
export SLURM_FINAL_PARTITION=hns # the final run of every stage on the filled caches (long CPU partition)
export N_TABLE_BLOCKS=8 # row blocks per human table, one CPU task each
