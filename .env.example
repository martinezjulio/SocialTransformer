# SocialTransformer Environment Configuration
# Copy this file to .env and update with your machine's absolute paths.
#
# These variables point to directories OUTSIDE the repo (data and experiments).
export CONDA_SETUP=/path/to/conda.sh # Path to conda.sh setup script (e.g., ~/miniforge3/etc/profile.d/conda.sh)
export TRAINING_DATA_ROOT_DIR=/path/to/training_data # Root data directory - where datasets will be generated and stored
export OUTPUT_DATA_DIR=/path/to/outputs # Root output directory.
export EXPERIMENT_DATA_DIR=/path/to/experiment_data # Root directory for human experiment data
export WANDB_ENTITY=your-wandb-username # your wandb username
export WANDB_PROJECT=your-project-name # your wandb project name
# SLURM (scripts/slurm/submit.sh); optional, the defaults are Sherlock's
export SLURM_CPU_PARTITION=owners,normal # table blocks and assembly: whichever partition frees first (preemption on owners only requeues a cached unit)
export SLURM_GPU_PARTITION=owners # fits, simulated datasets and PPC draws, one GPU each (owners preempts and requeues). Not owners,gpu: the gpu QOS counts every queued array task against a 100-task submit cap, so a full chain cannot be queued with it; move stragglers to gpu by hand (scontrol update JobId=<array>_<task> Partition=owners,gpu)
export SLURM_ARRAY_CHUNK=96 # tasks per array; the gpu QOS refuses larger arrays
export SLURM_FINAL_PARTITION=hns,normal # the final run of every stage on the filled caches (long CPU partitions)
export N_TABLE_BLOCKS=8 # row blocks per human table, one CPU task each (32 with 4-core tasks fits scheduler gaps better; a pilot 8-block task peaks at ~6 GB on 16 cores)
export SLURM_TABLE_CPUS=16 # cores per table block task
export SLURM_TABLE_MEM=64G # memory per table block task
export SLURM_TABLE_TIME=4:00:00 # time limit per table block task (a full-data large-grid block of 1/64 takes 2-3 h on 4 cores, ~1.5 h on 8)
export SLURM_FINAL_TIME=12:00:00 # time limit of the final run (24:00:00 for the full data)
export SLURM_FINAL_MEM=64G # memory of the final run (the pilot's peaked at 64 GB; 128G for the full data)
# export SLURM_GPU_OPTS="--gpu_cmode=shared -C (GPU_GEN:AMP|GPU_GEN:HPR|GPU_GEN:LOV|GPU_GEN:VLT)&(GPU_MEM:48GB|GPU_MEM:80GB|GPU_MEM:141GB)" # Sherlock: shared compute mode (the fits need a second CUDA context); no Pascal GPUs (a recovery dataset took 2 h on a P40, 7-43 min on Ampere/Hopper) and at least 48 GB of GPU memory (full-data fallback refits ran out on 24 and 40 GB cards)
export SLURM_GPU_MEM=32G # memory per GPU unit (a pilot recovery dataset peaked at 22 GB; 48G on Sherlock)
export SLURM_GPU_TIME=2:00:00 # time limit per GPU unit (pilot recovery datasets 16-120 min on mixed GPUs; 4:00:00 on Sherlock)
# export RENV_PATHS_CACHE=/path/to/renv-cache # renv's package cache, when $XDG_CACHE_HOME is temporary (Sherlock sets it to /tmp)
# export CONTAINER=/path/to/rocky9.sif # Apptainer image the pipeline runs inside (Sherlock: CentOS 7 nodes, glibc too old for the wheels); scripts/with_env.sh
