# Cluster Environment Configuration
# Copy this file to .env.cluster and update with cluster-specific absolute paths.
# Used automatically by scripts/run_training.sbatch; can also be opted into by any
# other script via:  ENV_FILE=.env.cluster bash scripts/<script>.sh

export CONDA_SETUP=/cluster/path/to/conda.sh # Path to conda.sh setup script on the cluster
export TRAINING_DATA_ROOT_DIR=/cluster/path/to/training_data # Cluster root for datasets
export OUTPUT_DATA_DIR=/cluster/path/to/outputs # Cluster root for experiment outputs
export EXPERIMENT_DATA_DIR=/cluster/path/to/experiment_data # Cluster root for human experiment data
export WANDB_ENTITY=your-wandb-username # your wandb username
export WANDB_PROJECT=your-project-name # your wandb project name
